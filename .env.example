# Engram environment configuration.
# Copy to `.env` and fill in your real DashScope API key.

# Required: your DashScope (Qwen) API key.
DASHSCOPE_API_KEY=

# Optional overrides (defaults shown).
# BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# MODEL_FLASH=qwen3.5-flash
# MODEL_HEAVY=qwen3-max
# MODEL_EMBED=text-embedding-v3
# CHROMA_PATH=./chroma_db
# SQLITE_PATH=./engram.sqlite
